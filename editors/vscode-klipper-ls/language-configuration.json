{
  "comments": { "lineComment": "#", "blockComment": ["{#", "#}"] },
  "brackets": [["[", "]"], ["{", "}"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["[", "]"], ["{", "}"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*([A-Za-z0-9_]*gcode\\s*[:=]\\s*$|\\{%-?\\s*(if|elif|else|for|macro)\\b.*%\\}\\s*$)",
    "decreaseIndentPattern": "^\\s*\\{%-?\\s*(elif|else|endif|endfor|endmacro)\\b"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
