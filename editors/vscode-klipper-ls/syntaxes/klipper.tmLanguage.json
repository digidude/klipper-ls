{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Klipper",
  "scopeName": "source.klipper",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#section"
    },
    {
      "include": "#template-option"
    },
    {
      "include": "#option"
    }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*[#;].*$",
      "name": "comment.line.number-sign.klipper"
    },
    "section": {
      "match": "^(\\[)\\s*([^\\s\\]]+)(?:\\s+([^\\]]*?))?\\s*(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.section.begin.klipper"
        },
        "2": {
          "name": "entity.name.type.section.klipper"
        },
        "3": {
          "name": "entity.name.section.klipper"
        },
        "4": {
          "name": "punctuation.definition.section.end.klipper"
        }
      },
      "name": "meta.section.klipper"
    },
    "template-option": {
      "begin": "^((?:[A-Za-z0-9_]*_)?gcode)\\s*([:=])",
      "beginCaptures": {
        "1": {
          "name": "support.type.property-name.klipper"
        },
        "2": {
          "name": "punctuation.separator.key-value.klipper"
        }
      },
      "end": "^(?=[^\\s#;])",
      "name": "meta.template.klipper",
      "patterns": [
        {
          "include": "#jinja"
        },
        {
          "include": "#template-comment"
        },
        {
          "include": "#gcode-line"
        }
      ]
    },
    "template-comment": {
      "match": "^\\s*[#;].*$|;.*$",
      "name": "comment.line.klipper"
    },
    "gcode-line": {
      "patterns": [
        {
          "match": "^\\s+([GMTgmt]\\d+(?:\\.\\d+)?|[A-Za-z_][A-Za-z0-9_]*)(?=\\s|$|\\{)",
          "captures": {
            "1": {
              "name": "entity.name.function.gcode.klipper"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(=)",
          "captures": {
            "1": {
              "name": "variable.parameter.klipper"
            },
            "2": {
              "name": "keyword.operator.assignment.klipper"
            }
          }
        },
        {
          "match": "\\b([XYZEFSPTIJRDHQxyzefsptijrdhq])(?=[-+.\\d{])",
          "name": "variable.parameter.klipper"
        },
        {
          "include": "#number"
        }
      ]
    },
    "option": {
      "match": "^([A-Za-z0-9_.\\-]+)\\s*([:=])\\s*(.*)$",
      "captures": {
        "1": {
          "name": "support.type.property-name.klipper"
        },
        "2": {
          "name": "punctuation.separator.key-value.klipper"
        },
        "3": {
          "patterns": [
            {
              "include": "#value"
            }
          ]
        }
      }
    },
    "value": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.klipper"
        },
        {
          "match": "(?i)\\b(true|false)\\b",
          "name": "constant.language.boolean.klipper"
        },
        {
          "match": "(?<![\\w.])[\\^!~]+(?=[A-Za-z0-9_:])|(?<=[\\^!~])[A-Za-z0-9_]+:[A-Za-z0-9_.]+|[A-Za-z0-9_]+:[A-Za-z0-9_.]+",
          "name": "constant.other.pin.klipper"
        },
        {
          "include": "#number"
        }
      ]
    },
    "number": {
      "match": "(?<![\\w.])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?(?![\\w])",
      "name": "constant.numeric.klipper"
    },
    "jinja": {
      "patterns": [
        {
          "begin": "\\{#",
          "end": "#\\}",
          "name": "comment.block.jinja.klipper"
        },
        {
          "begin": "\\{%-?",
          "end": "-?%\\}",
          "name": "meta.statement.jinja.klipper",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.tag.begin.klipper"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.tag.end.klipper"
            }
          },
          "patterns": [
            {
              "include": "#jinja-expr"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.expression.jinja.klipper",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.expression.begin.klipper"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.expression.end.klipper"
            }
          },
          "patterns": [
            {
              "include": "#jinja-expr"
            }
          ]
        }
      ]
    },
    "jinja-expr": {
      "patterns": [
        {
          "match": "\\b(if|elif|else|endif|for|endfor|in|set|macro|endmacro|and|or|not|is|call|endcall|raw|endraw)\\b",
          "name": "keyword.control.jinja.klipper"
        },
        {
          "match": "\\b(true|false|none|True|False|None)\\b",
          "name": "constant.language.jinja.klipper"
        },
        {
          "match": "\\b(printer|params|rawparams|action_[a-z_]+)\\b",
          "name": "support.variable.klipper"
        },
        {
          "match": "(\\|)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.jinja.klipper"
            },
            "2": {
              "name": "support.function.filter.jinja.klipper"
            }
          }
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.klipper"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.klipper"
        },
        {
          "include": "#number"
        },
        {
          "match": "[-+*/%<>=!~.,:()\\[\\]]+",
          "name": "keyword.operator.jinja.klipper"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#jinja-expr"
            }
          ]
        }
      ]
    }
  }
}